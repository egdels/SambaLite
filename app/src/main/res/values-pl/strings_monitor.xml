    <string name="sync_error_network_hint">Połączenie z serwerem nie powiodło się lub zostało przerwane. Sprawdź, czy serwer jest włączony i w tej samej sieci.</string>
    <string name="sync_error_auth">Logowanie odrzucone</string>
