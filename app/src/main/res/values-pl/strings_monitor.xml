    <string name="sync_error_local_access">Brak dostępu na urządzeniu</string>
    <string name="sync_error_local_access_hint">Nie udało się odczytać ani zapisać pliku na urządzeniu. Sprawdź, czy folder nadal zezwala na dostęp.</string>
