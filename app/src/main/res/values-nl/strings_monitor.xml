    <string name="sync_error_invalid_name_likely_hint">De server gaf geen duidelijke reden. Namen die eindigen op een punt of spatie zijn geldig in SMB, maar Windows-servers weigeren ze vaak. Hernoem het bestand als de fout blijft.</string>
    <string name="sync_error_name_too_long">Pad te lang</string>
    <string name="sync_error_name_too_long_hint">De server accepteert zo\'n lang pad niet. Maak map- of bestandsnamen korter.</string>
    <string name="sync_error_server_full">Serveropslag vol</string>
    <string name="sync_error_server_full_hint">Het volume van de share is vol. Maak ruimte vrij op de server.</string>
    <string name="sync_error_file_in_use">Bestand in gebruik</string>
    <string name="sync_error_file_in_use_hint">Een ander programma heeft het bestand op de server geopend. De volgende run probeert het opnieuw.</string>
    <string name="sync_error_not_found">Bestand verdwenen</string>
    <string name="sync_error_not_found_hint">Het bestand is tijdens de sync verplaatst of verwijderd. De volgende run haalt dat in.</string>
    <string name="sync_error_network">Server niet bereikbaar</string>
    <string name="sync_error_network_hint">De verbinding met de server is mislukt of verbroken. Controleer of de server aan staat en in hetzelfde netwerk zit.</string>
    <string name="sync_error_auth">Aanmelding geweigerd</string>
    <string name="sync_error_auth_hint">De server accepteerde de gebruikersnaam of het wachtwoord niet. Bewerk de verbinding op het startscherm.</string>
    <string name="sync_error_share_not_found">Share niet gevonden</string>
    <string name="sync_error_share_not_found_hint">De share bestaat niet meer op de server of is hernoemd. Bewerk de verbinding op het startscherm.</string>
    <string name="sync_error_local_access">Geen toegang op het apparaat</string>
    <string name="sync_error_local_access_hint">Het bestand op het apparaat kon niet worden gelezen of geschreven. Controleer of de map nog toegang toestaat.</string>
    <string name="sync_error_local_folder_missing">Lokale map niet meer bereikbaar</string>
    <string name="sync_error_local_folder_missing_hint">De map op het apparaat is verwijderd of de toegangsrechten zijn ingetrokken. Opnieuw proberen geeft dezelfde fout; kies de map opnieuw.</string>
    <string name="sync_error_local_space">Opslag bijna vol</string>
    <string name="sync_error_local_space_hint">De sync is gestopt om ruimte vrij te houden op het apparaat. Maak opslag vrij en synchroniseer opnieuw.</string>
