    <string name="sync_error_access_denied">Toegang geweigerd</string>
    <string name="sync_error_access_denied_hint">De servergebruiker van deze verbinding mag hier niet lezen of schrijven. Controleer de rechten van share en map op de server.</string>
    <string name="sync_error_invalid_name">Ongeldige bestandsnaam op de server</string>
    <string name="sync_error_invalid_name_hint">SMB staat de tekens \\ / : * ? \" &lt; &gt; | in namen niet toe, en veel servers weigeren ook een punt of spatie aan het eind. Hernoem het bestand.</string>
