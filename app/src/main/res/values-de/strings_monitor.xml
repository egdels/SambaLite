    <string name="sync_fix_wifi_title">Wartet auf WLAN</string>
    <string name="sync_fix_wifi_text">Dieser Sync läuft nur über WLAN und ist seit %1$s nicht gelaufen, weil das Gerät nicht im WLAN war, als er fällig war. Er startet von selbst, sobald WLAN verfügbar ist.</string>
    <string name="sync_fix_wifi_action">Einmal über Mobilfunk synchronisieren</string>
    <string name="sync_fix_overdue_title">Überfällig</string>
    <string name="sync_fix_overdue_text">Android hat diesen Sync seit %1$s nicht ausgeführt (Intervall: %2$s). Datensparmodus oder Energiesparfunktionen des Herstellers können Hintergrundarbeit zurückhalten.</string>
    <string name="sync_fix_overdue_text_battery">Android hat diesen Sync seit %1$s nicht ausgeführt (Intervall: %2$s). Für SambaLite ist die Akku-Optimierung aktiv, die Hintergrundarbeit zurückhalten kann.</string>

    <string name="sync_error_access_denied">Zugriff verweigert</string>
    <string name="sync_error_access_denied_hint">Der Server-Benutzer dieser Verbindung darf hier nicht lesen oder schreiben. Prüfe die Rechte von Freigabe und Ordner auf dem Server.</string>
    <string name="sync_error_invalid_name">Ungültiger Dateiname auf dem Server</string>
    <string name="sync_error_invalid_name_hint">SMB erlaubt die Zeichen \\ / : * ? \" &lt; &gt; | in Namen nicht, und viele Server lehnen auch einen Punkt oder ein Leerzeichen am Ende ab. Benenne die Datei um.</string>
    <string name="sync_error_invalid_name_likely">Name vom Server vermutlich abgelehnt</string>
    <string name="sync_error_invalid_name_likely_hint">Der Server nannte keinen klaren Grund. Namen, die mit einem Punkt oder Leerzeichen enden, sind in SMB erlaubt, werden von Windows-Servern aber oft abgelehnt. Benenne die Datei um, wenn der Fehler bleibt.</string>
    <string name="sync_error_name_too_long">Pfad zu lang</string>
    <string name="sync_error_name_too_long_hint">Der Server akzeptiert so lange Pfade nicht. Kürze Ordner- oder Dateinamen.</string>
    <string name="sync_error_server_full">Server-Speicher voll</string>
    <string name="sync_error_server_full_hint">Das Volume der Freigabe ist voll. Schaffe Platz auf dem Server.</string>
    <string name="sync_error_file_in_use">Datei in Benutzung</string>
    <string name="sync_error_file_in_use_hint">Ein anderes Programm hat die Datei auf dem Server geöffnet. Der nächste Lauf versucht es erneut.</string>
    <string name="sync_error_not_found">Datei verschwunden</string>
    <string name="sync_error_not_found_hint">Die Datei wurde während des Syncs verschoben oder gelöscht. Der nächste Lauf holt das nach.</string>
    <string name="sync_error_network">Server nicht erreichbar</string>
    <string name="sync_error_network_hint">Die Verbindung zum Server ist fehlgeschlagen oder abgebrochen. Prüfe, ob der Server eingeschaltet und im selben Netzwerk ist.</string>
    <string name="sync_error_auth">Anmeldung abgelehnt</string>
    <string name="sync_error_auth_hint">Der Server hat Benutzername oder Passwort nicht akzeptiert. Bearbeite die Verbindung auf dem Startbildschirm.</string>
    <string name="sync_error_share_not_found">Freigabe nicht gefunden</string>
    <string name="sync_error_share_not_found_hint">Die Freigabe gibt es auf dem Server nicht mehr, oder sie wurde umbenannt. Bearbeite die Verbindung auf dem Startbildschirm.</string>
    <string name="sync_error_local_access">Kein Zugriff auf dem Gerät</string>
    <string name="sync_error_local_access_hint">Die Datei auf dem Gerät konnte nicht gelesen oder geschrieben werden. Prüfe, ob der Ordner noch Zugriff erlaubt.</string>
    <string name="sync_error_local_folder_missing">Lokaler Ordner nicht mehr erreichbar</string>
    <string name="sync_error_local_folder_missing_hint">Der Ordner auf dem Gerät wurde gelöscht oder die Zugriffsberechtigung wurde entzogen. Ein neuer Versuch liefert denselben Fehler; wähle den Ordner neu aus.</string>
    <string name="sync_error_local_space">Speicher fast voll</string>
    <string name="sync_error_local_space_hint">Der Sync wurde gestoppt, damit auf dem Gerät Platz frei bleibt. Gib Speicher frei und synchronisiere dann erneut.</string>
    <string name="sync_error_folder_skipped">Ordner übersprungen</string>
    <string name="sync_error_folder_skipped_hint">Der Ordner ließ sich auf dem Server nicht auflisten, deshalb wurde sein Inhalt in diesem Lauf nicht synchronisiert.</string>
    <string name="sync_error_other">Anderer Fehler</string>
    <string name="sync_error_other_hint">Halte eine Datei gedrückt, um die Fehlermeldung zu sehen.</string>

