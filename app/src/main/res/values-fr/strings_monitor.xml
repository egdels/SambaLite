    <string name="sync_fix_wifi_title">Attend le WiFi</string>
    <string name="sync_fix_wifi_text">Cette synchronisation ne fonctionne qu\'en WiFi et n\'a pas eu lieu depuis %1$s, car l\'appareil n\'était pas en WiFi aux échéances. Elle démarrera d\'elle-même dès que le WiFi sera disponible.</string>
    <string name="sync_fix_wifi_action">Synchroniser une fois via les données mobiles</string>
    <string name="sync_fix_overdue_title">En retard</string>
    <string name="sync_fix_overdue_text">Android n\'a pas exécuté cette synchronisation depuis %1$s (intervalle : %2$s). L\'économiseur de données ou l\'économie d\'énergie du fabricant peuvent retenir les tâches en arrière-plan.</string>
    <string name="sync_fix_overdue_text_battery">Android n\'a pas exécuté cette synchronisation depuis %1$s (intervalle : %2$s). L\'optimisation de la batterie est active pour SambaLite, ce qui peut retenir les tâches en arrière-plan.</string>

    <string name="sync_error_access_denied">Accès refusé</string>
    <string name="sync_error_access_denied_hint">L\'utilisateur serveur de cette connexion ne peut pas lire ou écrire ici. Vérifiez les droits du partage et du dossier sur le serveur.</string>
    <string name="sync_error_invalid_name">Nom de fichier invalide sur le serveur</string>
    <string name="sync_error_invalid_name_hint">SMB n\'autorise pas les caractères \\ / : * ? \" &lt; &gt; | dans les noms, et de nombreux serveurs refusent aussi un point ou une espace à la fin. Renommez le fichier.</string>
    <string name="sync_error_invalid_name_likely">Nom probablement refusé par le serveur</string>
    <string name="sync_error_invalid_name_likely_hint">Le serveur n\'a pas donné de raison claire. Les noms qui se terminent par un point ou une espace sont valides en SMB, mais les serveurs Windows les refusent souvent. Renommez le fichier si l\'erreur persiste.</string>
    <string name="sync_error_name_too_long">Chemin trop long</string>
    <string name="sync_error_name_too_long_hint">Le serveur n\'accepte pas des chemins aussi longs. Raccourcissez les noms de dossiers ou de fichiers.</string>
    <string name="sync_error_server_full">Stockage du serveur plein</string>
    <string name="sync_error_server_full_hint">Le volume du partage est plein. Libérez de l\'espace sur le serveur.</string>
    <string name="sync_error_file_in_use">Fichier en cours d\'utilisation</string>
    <string name="sync_error_file_in_use_hint">Un autre programme a ouvert le fichier sur le serveur. La prochaine exécution réessaiera.</string>
    <string name="sync_error_not_found">Fichier disparu</string>
    <string name="sync_error_not_found_hint">Le fichier a été déplacé ou supprimé pendant la synchronisation. La prochaine exécution rattrapera cela.</string>
    <string name="sync_error_network">Serveur injoignable</string>
    <string name="sync_error_network_hint">La connexion au serveur a échoué ou a été interrompue. Vérifiez que le serveur est allumé et sur le même réseau.</string>
    <string name="sync_error_auth">Connexion refusée</string>
    <string name="sync_error_auth_hint">Le serveur n\'a pas accepté le nom d\'utilisateur ou le mot de passe. Modifiez la connexion sur l\'écran principal.</string>
    <string name="sync_error_share_not_found">Partage introuvable</string>
    <string name="sync_error_share_not_found_hint">Le partage n\'existe plus sur le serveur ou a été renommé. Modifiez la connexion sur l\'écran principal.</string>
    <string name="sync_error_local_access">Pas d\'accès sur l\'appareil</string>
    <string name="sync_error_local_access_hint">Le fichier sur l\'appareil n\'a pas pu être lu ou écrit. Vérifiez que le dossier autorise encore l\'accès.</string>
    <string name="sync_error_local_folder_missing">Dossier local inaccessible</string>
    <string name="sync_error_local_folder_missing_hint">Le dossier sur l\'appareil a été supprimé ou l\'autorisation d\'accès a été retirée. Réessayer donne la même erreur ; choisissez à nouveau le dossier.</string>
    <string name="sync_error_local_space">Stockage presque plein</string>
    <string name="sync_error_local_space_hint">La synchronisation s\'est arrêtée pour garder de l\'espace libre sur l\'appareil. Libérez du stockage, puis synchronisez à nouveau.</string>
    <string name="sync_error_folder_skipped">Dossier ignoré</string>
    <string name="sync_error_folder_skipped_hint">Le dossier n\'a pas pu être listé sur le serveur, son contenu n\'a donc pas été synchronisé lors de cette exécution.</string>
    <string name="sync_error_other">Autre erreur</string>
    <string name="sync_error_other_hint">Appuyez longuement sur un fichier pour voir le message d\'erreur.</string>

