    <string name="sync_fix_overdue_title">Atrasada</string>
    <string name="sync_fix_overdue_text">Android no ha ejecutado esta sincronización desde hace %1$s (intervalo: %2$s). El ahorro de datos o el ahorro de energía del fabricante pueden retener el trabajo en segundo plano.</string>
    <string name="sync_fix_overdue_text_battery">Android no ha ejecutado esta sincronización desde hace %1$s (intervalo: %2$s). La optimización de batería está activa para SambaLite y puede retener el trabajo en segundo plano.</string>

    <string name="sync_error_access_denied">Acceso denegado</string>
    <string name="sync_error_access_denied_hint">El usuario del servidor de esta conexión no puede leer ni escribir aquí. Revisa los permisos del recurso compartido y de la carpeta en el servidor.</string>
    <string name="sync_error_invalid_name">Nombre de archivo no válido en el servidor</string>
    <string name="sync_error_invalid_name_hint">SMB no permite los caracteres \\ / : * ? \" &lt; &gt; | en los nombres, y muchos servidores también rechazan un punto o espacio al final. Cambia el nombre del archivo.</string>
    <string name="sync_error_invalid_name_likely">Nombre probablemente rechazado por el servidor</string>
    <string name="sync_error_invalid_name_likely_hint">El servidor no dio un motivo claro. Los nombres que terminan en punto o espacio son válidos en SMB, pero los servidores Windows suelen rechazarlos. Cambia el nombre del archivo si el error persiste.</string>
    <string name="sync_error_name_too_long">Ruta demasiado larga</string>
    <string name="sync_error_name_too_long_hint">El servidor no acepta rutas tan largas. Acorta los nombres de carpetas o archivos.</string>
    <string name="sync_error_server_full">Almacenamiento del servidor lleno</string>
    <string name="sync_error_server_full_hint">El volumen del recurso compartido está lleno. Libera espacio en el servidor.</string>
    <string name="sync_error_file_in_use">Archivo en uso</string>
    <string name="sync_error_file_in_use_hint">Otro programa tiene el archivo abierto en el servidor. La próxima ejecución lo volverá a intentar.</string>
    <string name="sync_error_not_found">Archivo desaparecido</string>
    <string name="sync_error_not_found_hint">El archivo se movió o eliminó durante la sincronización. La próxima ejecución lo recuperará.</string>
    <string name="sync_error_network">Servidor no accesible</string>
    <string name="sync_error_network_hint">La conexión con el servidor falló o se cortó. Comprueba que el servidor esté encendido y en la misma red.</string>
    <string name="sync_error_auth">Inicio de sesión rechazado</string>
    <string name="sync_error_auth_hint">El servidor no aceptó el usuario o la contraseña. Edita la conexión en la pantalla principal.</string>
    <string name="sync_error_share_not_found">Recurso compartido no encontrado</string>
    <string name="sync_error_share_not_found_hint">El recurso compartido ya no existe en el servidor o se renombró. Edita la conexión en la pantalla principal.</string>
    <string name="sync_error_local_access">Sin acceso en el dispositivo</string>
    <string name="sync_error_local_access_hint">No se pudo leer ni escribir el archivo en el dispositivo. Comprueba que la carpeta siga permitiendo el acceso.</string>
    <string name="sync_error_local_folder_missing">Carpeta local no accesible</string>
    <string name="sync_error_local_folder_missing_hint">La carpeta del dispositivo se eliminó o se retiró el permiso de acceso. Reintentar da el mismo error; vuelve a elegir la carpeta.</string>
    <string name="sync_error_local_space">Almacenamiento casi lleno</string>
    <string name="sync_error_local_space_hint">La sincronización se detuvo para dejar espacio libre en el dispositivo. Libera almacenamiento y vuelve a sincronizar.</string>
    <string name="sync_error_folder_skipped">Carpeta omitida</string>
    <string name="sync_error_folder_skipped_hint">No se pudo listar la carpeta en el servidor, así que su contenido no se sincronizó en esta ejecución.</string>
    <string name="sync_error_other">Otro error</string>
    <string name="sync_error_other_hint">Mantén pulsado un archivo para ver el mensaje de error.</string>

