    <string name="sync_fix_wifi_title">Espera WiFi</string>
    <string name="sync_fix_wifi_text">Esta sincronización solo funciona con WiFi y no se ha ejecutado desde hace %1$s, porque el dispositivo no estaba en WiFi cuando tocaba. Se iniciará sola en cuanto haya WiFi.</string>
