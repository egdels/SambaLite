<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Transfer type icon with container (matching item_file style) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/transfer_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                android:contentDescription="@string/content_desc_file_type_icon"
                app:tint="?attr/colorOnPrimaryContainer" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Status badge overlay on icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="@id/icon_container"
            app:layout_constraintBottom_toBottomOf="@id/icon_container"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/transfer_status_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="@string/content_desc_connection_status"
                tools:src="@drawable/ic_check_circle_green" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Transfer file name (matching item_file typography) -->
        <TextView
            android:id="@+id/transfer_name"
            tools:ignore="SelectableText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="normal"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            app:layout_constraintEnd_toStartOf="@id/more_options"
            app:layout_constraintTop_toTopOf="@id/icon_container"
            tools:text="Video_Urlaub.mp4" />

        <!-- One line: status (or a readable failure reason) · size or progress · folder -->
        <TextView
            android:id="@+id/transfer_status"
            tools:ignore="SelectableText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            app:layout_constraintEnd_toStartOf="@id/more_options"
            app:layout_constraintTop_toBottomOf="@id/transfer_name"
            tools:text="Transferring · 1.2 GB / 1.8 GB · Photos" />

        <!-- Progress of the running transfer -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/transfer_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:max="1000"
            android:visibility="gone"
            app:trackCornerRadius="2dp"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            app:layout_constraintEnd_toStartOf="@id/more_options"
            app:layout_constraintTop_toBottomOf="@id/transfer_status"
            tools:progress="650"
            tools:visibility="visible" />

        <!-- More options button -->
        <ImageButton
            android:id="@+id/more_options"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/content_desc_more_options"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Selection indicator (initially hidden) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selection_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:layout_constraintEnd_toEndOf="@id/icon_container"
            app:layout_constraintTop_toTopOf="@id/icon_container"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="@string/content_desc_selected"
                app:tint="?attr/colorOnPrimaryContainer" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
