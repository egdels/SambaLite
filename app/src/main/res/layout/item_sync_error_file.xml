<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/file_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="start"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textIsSelectable="false"
        android:typeface="monospace"
        tools:text="2024/03/IMG_0412.jpg" />

    <TextView
        android:id="@+id/file_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_chip"
        android:backgroundTint="@color/sync_status_warning_container"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/sync_status_warning_on_container"
        android:visibility="gone"
        tools:text="for 3 runs"
        tools:visibility="visible" />
</LinearLayout>
