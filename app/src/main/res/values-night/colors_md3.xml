<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 colour roles, dark scheme. Generated with the Material Color
  Utilities bundled in com.google.android.material (SchemeFidelity) from the
  logo blue #3DB7DC, so primaryContainer is the logo colour itself.
  values/ and values-night/ define the same names; the themes reference them
  once. No DynamicColors: the app keeps the colour of its launcher icon on
  every Android version instead of taking the wallpaper colours.
-->
<resources>
    <color name="md_primary">#62D4FA</color>
    <color name="md_onPrimary">#003544</color>
    <color name="md_primaryContainer">#3DB7DC</color>
