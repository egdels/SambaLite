    <string name="sync_skip_local_newer">the local copy is newer or equally new</string>

    <!-- Notifications -->
    <string name="sync_notify_channel_name">Sync problems</string>
    <string name="sync_notify_channel_description">Tells you when a folder sync stops working and when it works again</string>
    <string name="sync_notify_failed_title">%1$s could not sync</string>
    <string name="sync_notify_low_space_title">%1$s stopped: storage almost full</string>
    <plurals name="sync_notify_errors_title">
        <item quantity="one">%1$s: %2$d file not synced</item>
        <item quantity="other">%1$s: %2$d files not synced</item>
    </plurals>
    <string name="sync_notify_recovered_title">%1$s syncs again</string>
    <string name="sync_notify_overdue_title">%1$s is overdue</string>
    <string name="sync_notify_overdue_text">This sync only runs on WiFi and has not run for a while. Tap to sync once over mobile data.</string>
    <string name="sync_notify_mute">Mute for this sync</string>
