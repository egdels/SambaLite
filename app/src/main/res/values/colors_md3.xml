<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 colour roles, light scheme. Generated with the Material Color
  Utilities bundled in com.google.android.material (SchemeFidelity) from the
  logo blue #3DB7DC, so primaryContainer is the logo colour itself.
  values/ and values-night/ define the same names; the themes reference them
  once. On Android 12+ DynamicColors replaces them with the wallpaper colours.
-->
<resources>
    <color name="md_primary">#006780</color>
    <color name="md_onPrimary">#FFFFFF</color>
    <color name="md_primaryContainer">#3DB7DC</color>
    <color name="md_onPrimaryContainer">#004556</color>
